# Colabre - variáveis de ambiente
PORT=8100
HOST=0.0.0.0
NODE_ENV=production
DB_PATH=./data/colabre.sqlite

# E-mail real (Resend). Sem isso, os códigos só aparecem no terminal (desenvolvimento).
EMAIL_DRIVER=resend
RESEND_API_KEY=
EMAIL_FROM=Colabre <nao-responda@seudominio.com>
APP_URL=http://localhost:8100

# Origens adicionais permitidas (separadas por vírgula), além da própria.
ALLOWED_ORIGINS=

# Validação de domínio de e-mail por DNS/MX (1 = ativo, 0 = desativado).
VALIDATE_EMAIL_DNS=1

# Expor códigos na tela/JSON (1 = sim, 0 = não). Nunca ative em produção.
ALLOW_DEV_CODES=0